# Supabase project connection (Project Settings -> API)
# The anon/publishable key is safe to expose to the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for canonical/OG metadata and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://selected-items.smartmanager.me

# Required only for the scheduled sync endpoint (Phase 8,
# /api/cron/sync-products) — a server-to-server trigger has no admin
# browser session, so it uses this to bypass RLS the way an authenticated
# admin normally does through policy. Not required to run the site, the
# Admin panel, or a manually-triggered "Sync Now" (those go through the
# authenticated user's session + Row Level Security as usual).
# NEVER expose this to the browser or commit it to git.
# SUPABASE_SERVICE_ROLE_KEY=

# Admitad product automation (Phase 2, re-architected in a later phase to
# be account-level only). Server-side only, never exposed to the browser.
# ONE account-level connection: provide EITHER a ready-made access token OR
# a client id + secret pair (the adapter authenticates via OAuth2
# client_credentials over HTTP Basic auth, generated server-side from these
# — never hand-compute or store a base64 Authorization header yourself).
# There is intentionally NO per-program feed URL env var: every advertiser
# program (advertiser name, country, feed id/url, active flag, its own
# sync status) lives in the admitad_programs Supabase table instead, managed
# from /admin/product-automation/admitad-programs — either via "Discover
# Programs" (an authenticated Admitad API call) or added by hand when a
# feed URL isn't available through discovery. Adding a program never
# requires touching Hostinger's environment variables.
# ADMITAD_ACCESS_TOKEN=
# ADMITAD_CLIENT_ID=
# ADMITAD_CLIENT_SECRET=
# Optional override if Admitad's API host differs from the default below.
# ADMITAD_API_BASE_URL=https://api.admitad.com

# CJ (Commission Junction / CJ Affiliate) product automation. Server-side
# only, never exposed to the browser. ONE account-level connection: CJ_API_KEY
# is a Personal Access Token (from CJ's developer portal, Authentication ->
# Personal Access Tokens) sent directly as a Bearer token — unlike Admitad,
# CJ has no separate OAuth token-exchange step. CJ_WEBSITE_ID is this
# account's own CID, used as the `companyId` argument to CJ's Product Search
# GraphQL API (and as `requestor-cid` for the secondary Advertiser Lookup
# API). There is intentionally NO per-advertiser env var: every advertiser
# relationship (name, whether it's enabled, its own sync status) lives in
# the cj_programs Supabase table instead, managed from
# /admin/product-automation/cj-programs — either via "Discover Advertisers"
# (pages through this account's product catalog filtered to advertisers
# it's actually joined — CJ's GraphQL API has no dedicated relationship-list
# query) or added by hand. Adding an advertiser never requires touching
# Hostinger's environment variables. Product synchronization pulls each
# enabled advertiser's products via the same Product Search GraphQL API,
# using its cj_advertiser_id to filter — trigger it with the "Sync CJ"
# button (or "Sync All").
# CJ_API_KEY=
# CJ_WEBSITE_ID=
# Optional override if CJ's Product Search GraphQL API host differs from the default below (confirmed correct/reachable as of 2026-09-21).
# CJ_GRAPHQL_API_URL=https://ads.api.cj.com/query
# Optional: the CJ "Property ID" (PID) used to generate tracked buy-now links via linkCode(pid: ...). Defaults to CJ_WEBSITE_ID — override only if a sync run shows generated links point at the wrong property (relevant for multi-property accounts).
# CJ_PID=
# Optional override if CJ's (secondary, no longer used for discovery) Advertiser Lookup API host differs from the default below.
# CJ_API_BASE_URL=https://advertiser-lookup.api.cj.com

# AI product classification (Phase 4). Server-side only, never exposed to
# the browser. Without this set, classification is skipped honestly (no
# fake results) — "Sync Now" and "Classify Pending" both report that
# plainly rather than fabricating a classification.
# ANTHROPIC_API_KEY=
# Optional override; defaults to a fast/cheap model suited to bulk classification.
# ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# Scheduled synchronization (Phase 8). Shared secret the /api/cron/sync-products
# endpoint requires as `Authorization: Bearer <value>`. Deployment is on
# Hostinger, which has no Vercel-Cron-style built-in scheduler — schedule
# this endpoint via hPanel's own "Cron Jobs" feature (shared/cloud/VPS
# plans all have it) running:
#   curl -s -H "Authorization: Bearer <this value>" https://your-domain.example/api/cron/sync-products
# On a VPS a regular system crontab entry with the same command works too.
# The endpoint is safe to call more often than the actual sync cadence —
# see "Sync interval" in the admin's Import configuration, which is what
# really controls how often a sync happens. Requires
# SUPABASE_SERVICE_ROLE_KEY above.
# CRON_SECRET=
