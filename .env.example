# Supabase project connection (Project Settings -> API)
# The anon/publishable key is safe to expose to the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for canonical/OG metadata and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://selected-items.smartmanager.me

# Required only for the scheduled sync endpoint (Phase 8,
# /api/cron/sync-products) — a server-to-server trigger has no admin
# browser session, so it uses this to bypass RLS the way an authenticated
# admin normally does through policy. Not required to run the site, the
# Admin panel, or a manually-triggered "Sync Now" (those go through the
# authenticated user's session + Row Level Security as usual).
# NEVER expose this to the browser or commit it to git.
# SUPABASE_SERVICE_ROLE_KEY=

# Admitad product automation (Phase 2). Server-side only, never exposed to
# the browser. Provide EITHER a ready-made access token OR a client id +
# secret pair (the adapter exchanges them for a token via OAuth2
# client_credentials). The product feed URL is required either way — it's
# your Admitad publisher account's own Product Feed export URL, not
# something this app guesses.
# ADMITAD_ACCESS_TOKEN=
# ADMITAD_CLIENT_ID=
# ADMITAD_CLIENT_SECRET=
# ADMITAD_PRODUCT_FEED_URL=
# Optional override if Admitad's API host differs from the default below.
# ADMITAD_API_BASE_URL=https://api.admitad.com

# AI product classification (Phase 4). Server-side only, never exposed to
# the browser. Without this set, classification is skipped honestly (no
# fake results) — "Sync Now" and "Classify Pending" both report that
# plainly rather than fabricating a classification.
# ANTHROPIC_API_KEY=
# Optional override; defaults to a fast/cheap model suited to bulk classification.
# ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# Scheduled synchronization (Phase 8). Shared secret the /api/cron/sync-products
# endpoint requires as `Authorization: Bearer <value>`. Deployment is on
# Hostinger, which has no Vercel-Cron-style built-in scheduler — schedule
# this endpoint via hPanel's own "Cron Jobs" feature (shared/cloud/VPS
# plans all have it) running:
#   curl -s -H "Authorization: Bearer <this value>" https://your-domain.example/api/cron/sync-products
# On a VPS a regular system crontab entry with the same command works too.
# The endpoint is safe to call more often than the actual sync cadence —
# see "Sync interval" in the admin's Import configuration, which is what
# really controls how often a sync happens. Requires
# SUPABASE_SERVICE_ROLE_KEY above.
# CRON_SECRET=
